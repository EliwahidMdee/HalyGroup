{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/media/*",
      "/api/*",
      "*.{css,js,png,jpg,jpeg,webp,svg,ico,otf,woff,woff2,mp4,json,txt}"
    ]
  },
  "platform": {
    "apiRuntime": "node:20"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
